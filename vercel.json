{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://prakashsvasudevan--2bid-engine-web.modal.run; frame-ancestors 'none'; base-uri 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/verify.html",
      "destination": "/verification-overview.html",
      "permanent": true
    },
    {
      "source": "/demo/creator.html",
      "destination": "/creator-overview.html",
      "permanent": true
    },
    {
      "source": "/demo/buyer.html",
      "destination": "/buyer-overview.html",
      "permanent": true
    },
    {
      "source": "/demo/verify.html",
      "destination": "/verification-overview.html",
      "permanent": true
    }
  ]
}